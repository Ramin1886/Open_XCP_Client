# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Rust source and configuration files
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.a2l text eol=lf
*.sh text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.sdf binary
*.exe binary
*.png binary
*.ico binary
