    "active_cal_page": 0
  },
  "ui": {
    "dark_mode": true,
    "enable_mock_server": false
  },
  "visualization": {
    "ego": {
      "length_m": 4.85,
      "width_m": 1.90,
      "rear_axle_to_center_m": 1.425,
      "show_ego": true,
      "iso8855_axes": true
